# Database (PostgreSQL - local dev)
# Production: Neon.tech connection string (see .env.vercel.example)
DATABASE_URL="postgresql://user:password@localhost:5432/outreachai"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (magic link) - optional
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@outreachai.app"

# AWS Bedrock (REQUIRED for AI features)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BEDROCK_REGION="us-east-1"

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Google Places API (optional - for scraper)
GOOGLE_PLACES_KEY=""

# Stripe (optional - for payments)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Admin email (REQUIRED)
ADMIN_EMAIL="janmikolajczak77@gmail.com"

# Dev mode (local only - don't set in production)
NEXT_PUBLIC_DEV_MOCK_AUTH="false"
