# ============================================
# OUTREACH AI — VERCEL ENVIRONMENT VARIABLES
# ============================================
# Skopiuj te zmienne do panelu Vercel → Settings → Environment Variables
# Ustaw dla: Production, Preview, Development

# ==================
# DATABASE (REQUIRED)
# ==================
# PostgreSQL connection string z Neon.tech
# Jak uzyskać: neon.tech → Create Project → Copy connection string
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"

# ==================
# NEXTAUTH (REQUIRED)
# ==================
# Sekretny klucz do szyfrowania sesji (wygeneruj: openssl rand -base64 32)
AUTH_SECRET="WYGENERUJ_LOSOWY_STRING_32_ZNAKI"

# URL produkcyjny twojej aplikacji
# Production: https://twoja-domena.vercel.app
# Preview: ustaw na ${VERCEL_URL} (automatyczne)
NEXTAUTH_URL="https://twoja-domena.vercel.app"

# ==================
# GOOGLE OAUTH (OPTIONAL)
# ==================
# Google Cloud Console → APIs & Services → Credentials → Create OAuth Client
# Authorized redirect URIs: https://twoja-domena.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID="twoj-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="twoj-google-client-secret"

# ==================
# EMAIL (OPTIONAL)
# ==================
# SMTP do wysyłania magic linków logowania
# Możesz użyć: SendGrid, AWS SES, Mailgun, Resend.com
EMAIL_SERVER_HOST="smtp.sendgrid.net"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="apikey"
EMAIL_SERVER_PASSWORD="twoj-sendgrid-api-key"
EMAIL_FROM="noreply@twoja-domena.com"

# ==================
# AWS BEDROCK (REQUIRED)
# ==================
# AWS IAM → Create User → Attach Policy: AmazonBedrockFullAccess
# Pobierz Access Key ID i Secret Access Key
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-east-1"
AWS_BEDROCK_REGION="us-east-1"

# ==================
# TWILIO SMS (OPTIONAL)
# ==================
# Twilio Console → Account Info
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+48000000000"

# ==================
# STRIPE (OPTIONAL)
# ==================
# Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ==================
# GOOGLE PLACES API (OPTIONAL)
# ==================
# Google Cloud Console → APIs & Services → Enable "Places API (New)"
# Create Credentials → API Key
GOOGLE_PLACES_KEY=""

# ==================
# ADMIN (REQUIRED)
# ==================
# Email administratora (automatycznie dostaje role ADMIN przy pierwszym logowaniu)
ADMIN_EMAIL="twoj@email.com"

# ==================
# DEV MODE (DON'T SET IN PRODUCTION)
# ==================
# NIE USTAWIAJ TEJ ZMIENNEJ W PRODUKCJI!
# Tylko dla local dev - bypass auth
# NEXT_PUBLIC_DEV_MOCK_AUTH="false"
